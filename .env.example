NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MongoDB must run as a replica set so multi-document transactions work
MONGODB_URI=mongodb://127.0.0.1:27017/sipl_workflow_360?replicaSet=rs0

# redis | memory  (memory is for automated tests only)
REDIS_MODE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL=3600

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=5

LOG_LEVEL=info
SWAGGER_ENABLED=true
BODY_LIMIT=1mb

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SIPL Workflow 360 <no-reply@localhost>

SUPER_ADMIN_EMAIL=admin@sipl.local
SUPER_ADMIN_PASSWORD=SuperAdmin@12345
